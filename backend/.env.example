# MongoDB replica set; use a dedicated database per environment.
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DB=ketsip
# Generate a private random 32-byte-or-longer secret, not this example.
JWT_SECRET=replace-with-a-random-private-secret-at-least-32-characters
JWT_MINUTES=480
# Comma-separated browser origins.
CORS_ORIGINS=http://localhost:5173
SEED_ON_STARTUP=true
# Local demo only; choose a private password of at least 12 characters.
BOOTSTRAP_PASSWORD=replace-this-local-demo-password
